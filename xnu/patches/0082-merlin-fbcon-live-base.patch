diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -700,7 +700,28 @@
 static volatile uint32_t *fbcon_base;
 static uint32_t fbcon_width, fbcon_height, fbcon_stride;
 static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
+
+/* merlin: the panel scans ONE contiguous 1088x2340 buffer whose base the
+ * OVL layer-0 address register holds at handoff (LK leaves it pointing at
+ * the live scan buffer). Read it at probe time; the ADT "reg" is only the
+ * fallback for boards without the OVL (sweet/QEMU). */
+#define FBCON_OVL0_BASE        0x1400b000UL
+#define FBCON_OVL_L0_ADDR      (FBCON_OVL0_BASE + 0xf40)
+
+static uint32_t
+fbcon_live_base(void)
+{
+	volatile uint32_t const *ovl = (volatile uint32_t const *)
+	    ml_io_map_wcomb(FBCON_OVL0_BASE, 0x1000UL);
+	if (ovl != NULL) {
+		uint32_t a = ovl[0xf40 / 4];
+		if (a >= 0x40000000UL && a < 0x80000000UL && (a & 7) == 0) {
+			return a;
+		}
+	}
+	return 0;
+}
 
 static void
 fbcon_clear_row(uint32_t row)
 {
@@ -700,8 +700,17 @@
 	if (!fbcon_width || !fbcon_height || fbcon_stride < fbcon_width * 4) {
 		return;
 	}
-	fbcon_base = (volatile uint32_t *)ml_io_map_wcomb(reg[0], reg[1]);
+	{
+		uint32_t live = fbcon_live_base();
+		if (live) {
+			fbcon_base = (volatile uint32_t *)
+			    ml_io_map_wcomb(live, fbcon_height * fbcon_stride);
+		}
+	}
+	if (fbcon_base == NULL) {
+		fbcon_base = (volatile uint32_t *)ml_io_map_wcomb(reg[0], reg[1]);
+	}
 	if (fbcon_base != NULL) {
 		register_serial_functions(&sweet_fbcon_serial_functions);
 	}
 }
